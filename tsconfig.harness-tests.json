{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".context/harness-tests",
    "rootDir": "src",
    "target": "ES2022"
  },
  "include": [
    "src/harness/**/*.test.ts",
    "src/harness/**/*.ts",
    "src/app/canvas/_data/apply-mission-event.ts",
    "src/app/canvas/_data/apply-mission-event.test.ts",
    "src/app/canvas/_data/mission-realtime.ts",
    "src/app/canvas/_data/mission-realtime.test.ts",
    "src/core/contracts/types.ts",
    "src/core/contracts/validation.ts",
    "src/core/events/catalogue.ts",
    "src/core/idempotency.ts",
    "src/core/policy/engine.ts",
    "src/core/policy/quota.ts",
    "src/core/repositories/mission-repository.ts",
    "src/core/repositories/mission-service.ts",
    "src/core/server/database.ts",
    "src/core/server/repository-factory.ts",
    "src/core/server/supabase-mission-repository.ts"
  ]
}
