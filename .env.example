# Public application configuration
CARDEA_APP_ORIGIN=https://your-cardea-domain.example
CARDEA_COMPANION_ORIGIN=https://your-companion-domain.example
# Exact companion origin the canvas embeds and discovers WebMCP tools from.
# Must be a single concrete origin: no wildcards, no path. Absent means the canvas
# shows "companion not configured" and embeds nothing.
NEXT_PUBLIC_CARDEA_COMPANION_ORIGIN=https://your-companion-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "live" or "fixture". Defaults to fixture. Live additionally requires an
# authenticated Cardea session; anything else degrades to labelled fixtures.
NEXT_PUBLIC_CARDEA_DATA_MODE=

# Server-only optional persistence and autonomous runtime
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
COMPOSIO_API_KEY=
SUPERMEMORY_API_KEY=
# HMAC secret for Composio OAuth state tokens.
CARDEA_STATE_SECRET=
# HMAC secret for server-issued guest and judge session cookies.
# Required for judge redemption; guest cookies are signed when it is present.
CARDEA_SESSION_SECRET=
# SHA-256 hash of the judge code. Never store or commit the code itself.
# Absent value disables POST /api/judge/redeem entirely.
CARDEA_JUDGE_CODE_HASH=

# Optional Shopify storefront spike (BE-10). Absent means the capability is
# invisible: discovery returns nothing and the canvas section says so.
# Shopify's storefront MCP endpoints are public, so there is NO token here.
# Bare storefront hostname only: no scheme, port, or path.
CARDEA_SHOPIFY_STORE_DOMAIN=
# Publicly reachable https URL of Cardea's UCP agent profile, which Shopify
# fetches server-side before serving any tool call. Setting it moves the store
# onto the supported /api/ucp/mcp surface; leaving it blank uses the legacy
# /api/mcp surface, which Shopify sunsets 2026-08-31.
# Cardea serves its own at /api/integrations/shopify/agent-profile.
CARDEA_SHOPIFY_UCP_AGENT_PROFILE_URL=
# Optional override: "legacy" or "ucp". Normally leave unset and let the
# presence of the agent profile URL decide.
CARDEA_SHOPIFY_MCP_SURFACE=

# Operator-only migration credentials belong in a secure local environment,
# not in Vercel production runtime configuration.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
